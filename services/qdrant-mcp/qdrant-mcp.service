[Unit]
Description=Qdrant MCP server for code indexing (standalone container)
Requires=docker.service
After=docker.service network-online.target qdrant.service llama-embedding.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=${CONF_DEST}
User=${PUID}
Group=${PGID}
ExecStartPre=-/usr/bin/docker rm -f qdrant-mcp
ExecStart=/usr/bin/docker run --rm --name qdrant-mcp \
  --network ai-stack \
  --log-opt max-size=10m \
  --log-opt max-file=3 \
  -e TRANSPORT_MODE=http \
  -e HTTP_PORT=3000 \
  -e QDRANT_URL=http://qdrant:6333 \
  -e EMBEDDING_PROVIDER=openai \
  -e EMBEDDING_BASE_URL=http://llama-embedding:8080/v1 \
  -e OPENAI_BASE_URL=http://llama-embedding:8080/v1 \
  -e EMBEDDING_MODEL=qwen3-embedding-4b \
  -e EMBEDDING_DIMENSIONS=2560 \
  -e OPENAI_API_KEY=dummy \
  -e CODE_CHUNK_SIZE=2500 \
  -e CODE_CHUNK_OVERLAP=300 \
  -e CODE_BATCH_SIZE=64 \
  -p ${BIND_HOST}:${QDRANT_MCP_PORT}:3000 \
  -v ${CODE_DIR}:${CODE_DIR}:ro \
  --health-cmd "curl -f http://localhost:3000/mcp" \
  --health-interval 10s \
  --health-timeout 5s \
  --health-retries 5 \
  --health-start-period 20s \
  qdrant-mcp:latest
ExecStop=/usr/bin/docker stop qdrant-mcp
Restart=on-failure
RestartSec=30
TimeoutStartSec=300
TimeoutStopSec=60
StandardOutput=journal
StandardError=journal
SyslogIdentifier=qdrant-mcp

[Install]
WantedBy=multi-user.target
