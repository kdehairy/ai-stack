[Unit]
Description=AMD Device Metrics Exporter (standalone container)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=${CONF_DEST}
User=${PUID}
Group=${PGID}
ExecStartPre=-/usr/bin/docker rm -f amd-device-metrics
ExecStart=/usr/bin/docker run --rm --name amd-device-metrics \
  --network host \
  --log-opt max-size=10m \
  --log-opt max-file=3 \
  --device /dev/dri:/dev/dri \
  --device /dev/kfd:/dev/kfd \
  rocm/device-metrics-exporter:v1.1.0
ExecStop=/usr/bin/docker stop amd-device-metrics
Restart=on-failure
RestartSec=30
TimeoutStartSec=300
TimeoutStopSec=60
StandardOutput=journal
StandardError=journal
SyslogIdentifier=amd-device-metrics

[Install]
WantedBy=multi-user.target
