[Unit]
Description=llama.cpp inference server (standalone container)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=${CONF_DEST}
User=${PUID}
Group=${PGID}
ExecStartPre=-/usr/bin/docker rm -f llama
ExecStart=/usr/bin/docker run --rm --name llama \
  --network ai-stack \
  --log-opt max-size=10m \
  --log-opt max-file=3 \
  --device /dev/kfd \
  --device /dev/dri \
  --group-add ${VIDEO_GID} \
  --group-add ${RENDER_GID} \
  -e ROCR_VISIBLE_DEVICES=${GPU_DEVICES} \
  -p ${BIND_HOST}:${LLAMA_PORT}:8080 \
  -v ${MODELS_DIR}:/data/models/llamacpp:ro \
  -v ${BASE_DIR}/services/llama/models.ini:/etc/llama/models.ini:ro \
  --health-cmd "curl -f http://localhost:8080/health" \
  --health-interval 30s \
  --health-timeout 10s \
  --health-retries 5 \
  --health-start-period 60s \
  llama-cpp-rocm:latest \
  --models-preset /etc/llama/models.ini \
  --host 0.0.0.0 \
  --port 8080 \
  --models-max 1 \
  --metrics \
  -fa 1 \
  --parallel 1 \
  --jinja
ExecStop=/usr/bin/docker stop llama
Restart=on-failure
RestartSec=30
TimeoutStartSec=300
TimeoutStopSec=60
StandardOutput=journal
StandardError=journal
SyslogIdentifier=llama

[Install]
WantedBy=multi-user.target
