[Unit]
Description=llama.cpp inference server
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kdehairy
Group=docker
WorkingDirectory=/home/kdehairy/git_tree/ai-stack
EnvironmentFile=/home/kdehairy/git_tree/ai-stack/.env
ExecStart=/home/kdehairy/git_tree/ai-stack/start-llama.sh services/llama/docker-compose.yml
ExecStop=/usr/bin/docker compose -f services/llama/docker-compose.yml down
Restart=on-failure
RestartSec=30
TimeoutStartSec=300
TimeoutStopSec=60
StandardOutput=journal
StandardError=journal
SyslogIdentifier=llama

[Install]
WantedBy=multi-user.target
