[Unit]
Description=SearXNG metasearch engine
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kdehairy
Group=docker
WorkingDirectory=/home/kdehairy/git_tree/ai-stack
EnvironmentFile=/home/kdehairy/git_tree/ai-stack/.env
ExecStart=/usr/bin/docker compose -f services/searxng/docker-compose.yml up
ExecStop=/usr/bin/docker compose -f services/searxng/docker-compose.yml down
Restart=on-failure
RestartSec=30
TimeoutStartSec=300
TimeoutStopSec=60
StandardOutput=journal
StandardError=journal
SyslogIdentifier=searxng

[Install]
WantedBy=multi-user.target
