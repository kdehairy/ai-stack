[Unit]
Description=Open WebUI chat interface
Requires=docker.service
After=docker.service network-online.target llama.service searxng.service qdrant.service
Wants=network-online.target

[Service]
Type=simple
User=kdehairy
Group=docker
WorkingDirectory=/home/kdehairy/git_tree/ai-stack
EnvironmentFile=/home/kdehairy/git_tree/ai-stack/.env
ExecStart=/usr/bin/docker compose -f services/openwebui/docker-compose.yml up
ExecStop=/usr/bin/docker compose -f services/openwebui/docker-compose.yml down
Restart=on-failure
RestartSec=30
TimeoutStartSec=300
TimeoutStopSec=60
StandardOutput=journal
StandardError=journal
SyslogIdentifier=openwebui

[Install]
WantedBy=multi-user.target
