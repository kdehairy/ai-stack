[Unit]
Description=Local AI Stack (llama-server + SearXNG + OpenWebUI)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kdehairy
Group=docker
WorkingDirectory=/data/ai-stack

EnvironmentFile=/data/ai-stack/.env

ExecStartPre=/data/ai-stack/start-llama.sh --dry-run || true
ExecStart=/data/ai-stack/start-llama.sh --remove-orphans
ExecStop=/usr/bin/docker compose down

Restart=on-failure
RestartSec=30
TimeoutStartSec=300
TimeoutStopSec=60

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ai-stack

[Install]
WantedBy=multi-user.target
