    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Throughput on sda — the physical disk backing your /data XFS volume where models are stored. During model load you will see a large burst here (loading ~20 GB model file). During inference with -ot flag, if MoE expert pages have been evicted from RAM they will be re-read from disk here — this should not happen during normal operation but will appear if you run out of RAM.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
