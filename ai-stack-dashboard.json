    },

    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Tctl = what most tools report; includes a +27C offset on Zen 5 so 67C here = ~40C actual — use Tccd values for real die temperatures. Tccd1/Tccd2 = actual temperatures of each compute die (16 cores each). CPU Package from ASUS EC = motherboard's measurement of overall package power. VRM = voltage regulator temperature; above 90C causes CPU throttling. Currently at a healthy 45C.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
