# AI user
AI_UID=1100
AI_GID=1100

# Volumes base
VOLUMES_BASE=/data/ai-stack

# llama.cpp server
LLAMA_VERSION=b9524
LLAMA_HOST=127.0.0.1
LLAMA_CODER_PORT=8081
LLAMA_REASONER_PORT=8082
LLAMA_MODEL_PATH=/data/models/llamacpp
LLAMA_CODER_MODEL_FILE=GLM-4.7-Flash/GLM-4.7-Flash-UD-Q4_K_XL.gguf
LLAMA_REASONER_MODEL_FILE=GLM-4.7-Flash/GLM-4.7-Flash-UD-Q4_K_XL.gguf
LLAMA_CTX=65536
LLAMA_GPU_LAYERS=99

# Router mode configuration
ROUTER_MODE_ENABLED=true
DEFAULT_MODEL=Baloza-v3.0

# Searxng
SEARXNG_HOST=127.0.0.1
SEARXNG_PORT=8888

# OpenWebUI
OPENWEBUI_HOST=127.0.0.1
OPENWEBUI_PORT=3000

# Qdrant-MCP
QDRANT_MCP_HOST=127.0.0.1
QDRANT_MCP_PORT=3001

# Qdrant
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
