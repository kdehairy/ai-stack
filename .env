# AI user
AI_UID=1100
AI_GID=1100

# Volumes base
VOLUMES_BASE=/data/ai-stack

# llama.cpp server
LLAMA_VERSION=b9524
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8082
LLAMA_MODEL_PATH=/data/models/llamacpp
LLAMA_CTX=65536
LLAMA_GPU_LAYERS=99

# llama-embedding service
EMBEDDING_HOST=127.0.0.1
EMBEDDING_PORT=8081

# llama.cpp Router mode configuration
ROUTER_MODE_ENABLED=true
DEFAULT_MODEL=Baloza-v3.0

# Searxng
SEARXNG_HOST=127.0.0.1
SEARXNG_PORT=8888

# OpenWebUI
OPENWEBUI_HOST=127.0.0.1
OPENWEBUI_PORT=3000

# Qdrant-MCP
QDRANT_MCP_HOST=127.0.0.1
QDRANT_MCP_PORT=3001

# Qdrant
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
